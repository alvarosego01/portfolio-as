      <div class="col-span-3 mx-auto text-center pcTab:col-span-2 md:mx-0 md:text-left info">

        <div data-aos="zoom-out">
          <div
            class="relative text-sm  bg-gray-800 rounded-full inline-block px-4 py-1 mb-6 before:content-[''] before:absolute before:-z-10 before:inset-0 before:-m-0.5 before:bg-gradient-to-t before:from-gray-800 before:to-gray-800 before:via-gray-600 before:rounded-full">
            <div class="text-lightGray">
              FullStack Web Developer
            </div>
          </div>
        </div>
