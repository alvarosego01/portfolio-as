          data-aos="zoom-out" data-aos-delay="300">

          <div class="flex flex-row w-full gap-5 pcTab:gap-10">

            <div class="flex flex-row items-center space-x-3 ">
              <span class="text-6xl font-semibold numberCount">
                11
              </span>
              <span class="text-xl leading-normal text-lightGray">
