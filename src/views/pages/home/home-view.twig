              </span>
              <span class="text-xl leading-normal text-lightGray">
                Projects
                <br>
                Completed
              </span>
            </div>

          </div>

        </div>

      </div>

      <div class="col-span-3 mx-auto text-center pcTab:col-span-1 md:mx-0 md:text-left image">

      </div>


    </div>
  </div>
</section>

