{% from 'components/content/Tag_1.twig' import Component as Tag_1 %}

<section class="block mb-12 ">
  <div class="relative max-w-6xl px-4 mx-auto sm:px-6">

    <!-- Blurred shape -->
    <div class="absolute left-0 z-0 -ml-16 pointer-events-none blur-2xl opacity-70" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" width="434" height="427">
        <defs>
          <linearGradient id="bs4-a" x1="19.609%" x2="50%" y1="14.544%" y2="100%">
            <stop offset="0%" stop-color="#A855F7" />
            <stop offset="100%" stop-color="#6366F1" stop-opacity="0" />
          </linearGradient>
        </defs>
        <path fill="url(#bs4-a)" fill-rule="evenodd" d="m0 0 461 369-284 58z" transform="matrix(1 0 0 -1 0 427)" />
      </svg>
    </div>

    <div class="z-10 flex flex-col gap-12">

      <!-- Section header -->
      <div class="w-full " data-aos="zoom-out" data-aos-delay="100">
        <h2 class="mb-4 text-center h2 font-uncut-sans">
          My skills as <span class="text-primaryBlue">FullStack</span>
        </h2>
        <p class="text-lg text-center text-slate-400">Many desktop publishing packages and web page editors now use lorem
          ipsum as their default model text, and a search will uncover many web sites still in their infancy.
        </p>
      </div>

      <!-- Rows -->
      {# <div class="grid grid-cols-1 divide-y pcTab:divide-x pcTab:divide-y-0 pcTab:grid-cols-4 divide-slate-800"> #}

        <div class="grid grid-cols-1 gap-5 pcTab:grid-cols-4 ">

          {% for skill in skills %}

          <div class="flex flex-col col-span-1 gap-4 p-10 border border-gray-800 rounded-4xl pcTab:col-span-2 ">

            <h4 class="font-bold leading-tight title h4 text-mainWhite" data-aos="zoom-out" data-aos-delay="100">
              {{ skill.title }}
            </h4>

            <p class="text-sm text-slate-400" data-aos="zoom-out" data-aos-delay="100">
              {{ skill.desc }}
            </p>

            <div class="flex flex-row flex-wrap gap-y-2 gap-x-1 skills">
              {% set tags = skill.tags %}
                {% set count = 100 %}

              {% for tag in tags %}

                {% set count = count + 50 %}

              <div data-aos="zoom-out" data-aos-delay="{{ count }}">
                  {{
                    Tag_1({
                      text: tag.text,
                      icon: tag.icon,
                      iconCLass: tag.iconClass
                    })
                  }}
              </div>
              {% endfor %}
            </div>

          </div>

          {% endfor %}

        </div>


      </div>
    </div>
</section>