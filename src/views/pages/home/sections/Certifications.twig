<section class="block mt-20 mb-12 ">

  <div class="relative flex flex-col max-w-6xl gap-12 px-4 mx-auto sm:px-6">

    <div class=" titleContent" data-aos="zoom-out" data-aos-delay="100">
      <h2 class="mb-4 text-center h2 font-uncut-sans">
        My <span class="text-primaryBlue">certifications</span>
      </h2>
      <p class="text-lg text-center text-slate-400">Many desktop publishing packages and web page editors now use lorem
        ipsum as their default model text, and a search will uncover many web sites still in their infancy.
      </p>
    </div>

    <div class="content">

      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 pcTab:grid-cols-4">

        {% set count = 100 %}
        {% for cert in certifications %}

          {% set count = count + 50 %}
          {% set fields = cert.fields %}

          <div class="flex flex-col col-span-1 gap-4 p-4 cert bg-navyBlue rounded-2xl " data-aos="zoom-out" data-aos-delay="{{ count }}" >
              <div class="image">
                <a href="{{ fields.url_external }}" target="_blank">
                  <img src="{{ cert.thumbnail }}" alt="{{ cert.title }}" class="block m-auto rounded-2xl">
                </a>
              </div>
              <h4 class="h-12 mb-4 text-lg font-semibold pcTab:text-sm title text-mainWhite ">
                <a href="{{ fields.url_external }}" target="_blank">
                {{ cert.post_title }}
                </a>
              </h4>
              <div class="flex flex-row justify-between w-full opc">
                <div class="flex flex-row items-center gap-1 date">
                  <i class='text-lg bx bx-calendar-alt'  ></i>
                  <span class="text-xs text-lightGray">
                  {{ fields.date_certification }}
                  </span>
                </div>
                <a href="{{ get_wp_file(fields.file_certification, 'url') }}" class="flex items-center justify-center w-8 h-8 p-1 rounded-lg download bg-emerald-400" target="_blank">
                  <i class='text-lg bx bx-download' ></i>
                </a>
              </div>
          </div>

        {% endfor %}

      </div>

    </div>


  </div>

</section>