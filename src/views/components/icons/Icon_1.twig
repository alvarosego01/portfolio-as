{% from 'components/icons/Postgresql.twig' import Component as Postgresql %}
{% from 'components/icons/Mysql.twig' import Component as Mysql %}
{% from 'components/icons/Mongodb.twig' import Component as Mongodb %}
{% from 'components/icons/Python.twig' import Component as Python %}
{% from 'components/icons/Vite.twig' import Component as Vite %}
{% from 'components/icons/Git.twig' import Component as Git %}

{% set iconName = param.icon|lower %}

{% if iconName == 'angular' %}
  {{ Angular() }}
{% elseif iconName == 'ngrx' %}
  {{ Ngrx() }}
{% elseif iconName == 'react' %}
  {{ React() }}
{% elseif iconName == 'redux' %}
  {{ Redux() }}
{% elseif iconName == 'socketio' %}
  {{ Socketio() }}
{% elseif iconName == 'nestjs' %}
  {{ Nestjs() }}
{% elseif iconName == 'expressjs' %}
  {{ Express() }}
{% elseif iconName == 'ionic' %}
  {{ Ionic() }}
{% elseif iconName == 'nodejs' %}
  {{ Nodejs() }}
{% elseif iconName == 'docker' %}
  {{ Docker() }}
{% elseif iconName == 'typescript' %}
  {{ Typescript() }}
{% elseif iconName == 'javascript' %}
  {{ Javascript() }}
{% elseif iconName == 'html' %}
  {{ Html() }}
{% elseif iconName == 'css' %}
  {{ Css() }}
{% elseif iconName == 'sass' %}
  {{ Sass() }}
{% elseif iconName == 'tailwind' %}
  {{ Tailwind() }}
{% elseif iconName == 'bootstrap' %}
  {{ Bootstrap() }}
{% elseif iconName == 'php' %}
  {{ Php() }}
{% elseif iconName == 'laravel' %}
  {{ Laravel() }}
{% elseif iconName == 'symfony' %}
  {{ Symfony() }}
{% elseif iconName == 'wordpress' %}
  {{ Wordpress() }}
{% elseif iconName == 'postgresql' %}
  {{ Postgresql() }}
{% elseif iconName == 'mysql' %}
  {{ Mysql() }}
{% elseif iconName == 'mongodb' %}
  {{ Mongodb() }}
{% elseif iconName == 'python' %}
  {{ Python() }}
{% elseif iconName == 'vite' %}
  {{ Vite() }}
{% elseif iconName == 'git' %}
  {{ Git() }}
{% else %}
  {# Fallback for unknown icon value #}
{% endif %}

{% endmacro %}