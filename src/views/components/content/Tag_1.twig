{% macro Component(param = {
text: '',
icon: ''
}) %}

{% from 'components/icons/Icon_1.twig' import Component as Icon_1 %}

{% set text = param.text %}
{% set icon = param.icon %}

<div
  class="relative flex flex-row items-center justify-center gap-2 px-5 py-2 text-sm bg-gray-800 rounded-full tag_1">
  <div class="h-6 max-h-6 icon">
    {% if icon != '' %}
      {{
        Icon_1({
          icon: icon
        })
      }}
    {% endif %}
  </div>
  <span class="font-semibold leading-normal text text-lightGray">
    {{ text }}
  </span>
</div>

{% endmacro %}